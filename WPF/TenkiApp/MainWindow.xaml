<Window x:Class="TenkiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="TenkiApp"
        mc:Ignorable="d"
        Height="480" Width="700"
        FontFamily="Segoe UI" 
        Background="#1a1a1a">

    <Window.Resources>
        <Style TargetType="Button" x:Key="SearchButtonStyle">
            <Setter Property="Background" Value="#0099ff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Foreground" Value="#aaaaaa"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HourlyItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HourlyForecastBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#2c2c2c"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3a3a3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="15" Background="#282828" BorderBrush="#444444" BorderThickness="0,0,0,1">

            <Border Width="400" 
            Height="32"
            CornerRadius="5"  
            HorizontalAlignment="Center" 
            BorderBrush="#555555" 
            BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <TextBox 
                Width="310" 
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                Foreground="White"
                Background="#3a3a3a"  BorderThickness="0"  Height="32"
                FontSize="14"
                Padding="8,0,0,0"
                VerticalContentAlignment="Center"/>

                    <Button 
                Content="🔍 検索" 
                Command="{Binding SearchCommand}"
                Width="88"
                Height="32"
                Style="{StaticResource SearchButtonStyle}"
                Margin="0"  VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>

        </Border>
        <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentSummary.LocationName}" FontSize="30" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="{Binding CurrentSummary.WeatherIcon}" FontSize="60" Foreground="#ffee88" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding CurrentSummary.Temperature}" FontSize="78" FontWeight="ExtraLight" Foreground="#0099ff" VerticalAlignment="Center" Margin="0,0,30,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" Foreground="#999999">体感</TextBlock>
                    <TextBlock Text="{Binding CurrentSummary.ApparentTemperature}" FontSize="20" Foreground="#0099ff" Margin="0,2,0,10"/>
                    <TextBlock FontSize="14" Foreground="#999999">風速</TextBlock>
                    <TextBlock Text="{Binding CurrentSummary.WindSpeed}" FontSize="20" Foreground="#0099ff"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding CurrentSummary.WeatherDescription}" FontSize="18" Foreground="#cccccc" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="#3a3a3a" Margin="20,0,20,0"/>

        <Border Grid.Row="2" Margin="20,10,20,5">
            <TextBlock Text="時間別予報" HorizontalAlignment="Left" Foreground="#cccccc" FontSize="16" FontWeight="Light"/>
        </Border>

        <ListBox 
            Grid.Row="3" 
            ItemsSource="{Binding HourlyForecast}" 
            Margin="20,0,20,15"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource HourlyItemContainerStyle}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border 
                        Width="65" 
                        Margin="5,0" 
                        Padding="5" 
                        Style="{StaticResource HourlyForecastBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock 
                                Text="{Binding Time, StringFormat='HH:mm'}" 
                                HorizontalAlignment="Center" 
                                FontSize="12" 
                                Foreground="#888888"/>

                            <TextBlock 
                                Text="{Binding WeatherIcon}" 
                                HorizontalAlignment="Center" 
                                FontSize="28" 
                                Foreground="#ffee88"
                                Margin="0,5"/>

                            <TextBlock 
                                Text="{Binding Temperature, StringFormat='{} {0:F0}°C'}" 
                                HorizontalAlignment="Center" 
                                FontWeight="Medium" 
                                FontSize="14"
                                Foreground="White"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>